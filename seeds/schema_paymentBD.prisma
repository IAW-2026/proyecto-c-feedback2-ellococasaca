generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model balance_logs {
  id               Int       @id @default(autoincrement())
  user_id          String?   @db.VarChar(255)
  amount_change    Decimal   @db.Decimal(15, 2)
  previous_balance Decimal   @db.Decimal(15, 2)
  new_balance      Decimal   @db.Decimal(15, 2)
  transaction_type String?   @db.VarChar(50)
  reference_id     String?   @db.VarChar(255)
  created_at       DateTime? @default(now()) @db.Timestamptz(6)
  users            users?    @relation(fields: [user_id], references: [clerk_id], onDelete: NoAction, onUpdate: NoAction)
}



/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model charges {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  buyer_id         String?   @db.VarChar(255)
  order_id         String?
  amount           Decimal   @db.Decimal(15, 2)
  status           String?   @db.VarChar(50)
  mp_payment_id    String?   @db.VarChar(255) 
  products         Json?
  shipping_address Json?
  created_at       DateTime? @default(now()) @db.Timestamptz(6)
  users            users?    @relation(fields: [buyer_id], references: [clerk_id], onDelete: NoAction, onUpdate: NoAction)
  payouts          payouts[]
}



/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model payouts {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  seller_id  String?   @db.VarChar(255)
  amount     Decimal   @db.Decimal(15, 2)
  status     String?   @db.VarChar(50)
  charge_id  String?   @db.Uuid
  created_at DateTime? @default(now()) @db.Timestamptz(6)
  charges    charges?  @relation(fields: [charge_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  users      users?    @relation(fields: [seller_id], references: [clerk_id], onDelete: NoAction, onUpdate: NoAction)
}

model users {
  clerk_id       String         @id @db.VarChar(255)
  balance        Decimal        @default(0.00) @db.Decimal(15, 2)
  created_at     DateTime?      @default(now()) @db.Timestamptz(6)
  updated_at     DateTime?      @default(now()) @db.Timestamptz(6)
  balance_logs   balance_logs[]
  charges        charges[]
  payouts        payouts[]
}
